DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
DB_SCHEMA=public
DATABASE_URL="postgresql+psycopg://$DB_USER:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_NAME"
JWT_SECRET=""
FRONTEND_URL=
# Off by default so registration/login work without SES set up. Flip to
# "true" once SES production access is approved and SMTP_* vars are live.
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Sentry error reporting (free SaaS tier at sentry.io). Leave SENTRY_DSN
# blank to disable — both the backend and frontend no-op without it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
VITE_SENTRY_DSN=