{
  "name": "knight-school",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:playwright": "playwright test playwright-dashboard.spec.ts",
    "test:settings": "playwright test playwright-settings-preview-check.spec.ts",
    "test:smoke": "playwright test playwright-prod-smoke.spec.ts",
    "test:watch": "vitest --watch",
    "purgecss": "purgecss --config purgecss.config.cjs",
    "i18n:sync": "node scripts/sync-locales.mjs",
    "i18n:check": "node scripts/sync-locales.mjs --check"
  },
  "dependencies": {
    "@knight-school/chess-core": "file:../packages/chess-core",
    "axios": "^1.18.1",
    "cm-chessboard": "^8.12.19",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "purgecss": "^8.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "msw@2.15.0": true
  }
}
