<header class="site-header">
  <div class="site-header-inner">
    <div class="site-header-brand">
      <img src="/rails/favicon.svg" alt="" class="site-header-logo" height="40">
      <%= link_to "Knight School", (logged_in? ? dashboard_path : login_path), class: "site-header-title" %>
    </div>

    <% if logged_in? %>
      <div class="site-header-right">
        <nav class="site-header-nav" aria-label="Main">
          <%= link_to "Openings", dashboard_path,
                class: "site-header-nav-link#{' active' if request.path.start_with?(dashboard_path)}" %>

          <div class="site-header-actions">
            <a href="https://github.com/coliver/chess-trainer" class="site-header-profile-link"
                  target="_blank" rel="noopener noreferrer" aria-label="View source on GitHub" title="View source on GitHub">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.477 2 2 6.58 2 12.239c0 4.526 2.865 8.367 6.839 9.72.5.094.682-.22.682-.489 0-.242-.01-.882-.014-1.731-2.782.62-3.369-1.376-3.369-1.376-.455-1.188-1.11-1.504-1.11-1.504-.908-.636.069-.623.069-.623 1.004.072 1.532 1.05 1.532 1.05.892 1.561 2.341 1.11 2.91.848.091-.662.35-1.11.636-1.365-2.22-.258-4.555-1.134-4.555-5.04 0-1.113.39-2.024 1.029-2.738-.103-.259-.446-1.3.098-2.708 0 0 .84-.275 2.75 1.047A9.3 9.3 0 0 1 12 6.844c.85.004 1.705.116 2.504.34 1.909-1.322 2.747-1.047 2.747-1.047.546 1.408.202 2.449.1 2.708.64.714 1.028 1.625 1.028 2.738 0 3.916-2.339 4.778-4.566 5.03.36.313.678.93.678 1.874 0 1.353-.012 2.443-.012 2.774 0 .272.18.587.688.487A10.246 10.246 0 0 0 22 12.239C22 6.58 17.523 2 12 2Z" />
              </svg>
            </a>

            <% prefs = current_preferences %>
            <%= form_with url: settings_path, method: :patch, data: { controller: "theme-toggle" }, style: "display: contents" do %>
              <%= hidden_field_tag :return_to, request.path %>
              <%= hidden_field_tag :theme, prefs["theme"], data: { theme_toggle_target: "themeField" } %>
              <%= hidden_field_tag :board_theme, prefs["board_theme"] %>
              <%= hidden_field_tag :piece_set, prefs["piece_set"] %>
              <%= hidden_field_tag :show_coordinates, prefs["show_coordinates"] %>
              <%= hidden_field_tag :board_animations, prefs["board_animations"] %>
              <%= hidden_field_tag :board_orientation_mode, prefs["board_orientation_mode"] %>
              <%= hidden_field_tag :sound, prefs["sound"] %>
              <button type="button" class="theme-toggle-btn" data-action="theme-toggle#toggle" aria-label="Toggle theme" title="Toggle theme">
                <span data-theme-toggle-target="sunIcon" hidden aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z" stroke="currentColor" stroke-width="2" />
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  </svg>
                </span>
                <span data-theme-toggle-target="moonIcon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M21 13.2A8.4 8.4 0 0 1 10.8 3a6.9 6.9 0 1 0 10.2 10.2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                  </svg>
                </span>
              </button>
            <% end %>

            <%= link_to "Settings", settings_path,
                  class: "site-header-nav-link#{" active" if request.path.start_with?(settings_path)}" %>
            <%= button_to "Log out", logout_path, method: :delete,
                  class: "site-header-nav-link", form: { style: "display: contents" } %>
          </div>
        </nav>
      </div>
    <% end %>
  </div>
</header>
