<% content_for :title, "Verify email" %>

<main class="page">
  <div class="card" style="max-width: 520px; margin-top: 20px;">
    <% if @state == :success %>
      <h1 class="title" style="margin-bottom: 6px;">Email verified</h1>
      <p class="subtitle">
        <% if @email %>
          <%= @email %> is now verified. You can log in.
        <% else %>
          Your email is now verified. You can log in.
        <% end %>
      </p>
      <p style="margin-top: 20px;">
        <%= link_to "Go to login", login_path, class: "btn", style: "display: inline-block;" %>
      </p>
    <% else %>
      <h1 class="title" style="margin-bottom: 6px;">Verification failed</h1>
      <p class="subtitle">This link is invalid or has expired.</p>
      <p style="margin-top: 20px;">
        <%= link_to "Return to login", login_path, class: "btn", style: "display: inline-block;" %>
      </p>
    <% end %>
  </div>
</main>
