<% content_for :title, "Verify email" %>

<main class="page">
  <div class="card" style="max-width: 520px; margin-top: 20px;">
    <% if @state == :success %>
      <h1 class="title" style="margin-bottom: 6px;"><%= t(".verified_title") %></h1>
      <p class="subtitle">
        <% if @email %>
          <%= t(".verified_with_email", email: @email) %>
        <% else %>
          <%= t(".verified_generic") %>
        <% end %>
      </p>
      <p style="margin-top: 20px;">
        <%= link_to t(".go_to_login"), login_path, class: "btn", style: "display: inline-block;" %>
      </p>
    <% else %>
      <h1 class="title" style="margin-bottom: 6px;"><%= t(".failed_title") %></h1>
      <p class="subtitle"><%= t(".failed_subtitle") %></p>
      <p style="margin-top: 20px;">
        <%= link_to t(".return_to_login"), login_path, class: "btn", style: "display: inline-block;" %>
      </p>
    <% end %>
  </div>
</main>
