<% content_for :title, "Check your email" %>

<main class="page">
  <div class="card" style="max-width: 520px; margin-top: 20px;">
    <h1 class="title" style="margin-bottom: 6px;"><%= t(".title") %></h1>
    <p class="subtitle"><%= t(".subtitle") %> <strong><%= @email %></strong>.</p>

    <p class="auth-alt" style="margin-top: 20px;">
      <%= link_to t(".return_to_login"), login_path %>
    </p>
  </div>
</main>
