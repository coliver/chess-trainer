<% content_for :title, "Register" %>

<main class="page">
  <div class="card" style="max-width: 520px; margin-top: 20px;">
    <h1 class="title" style="margin-bottom: 6px;">Register</h1>
    <p class="subtitle">Create your Knight School account.</p>

    <%= form_with url: register_path, method: :post, local: true, class: "auth-form" do %>
      <label class="auth-field">
        <span class="auth-label">Email</span>
        <%= email_field_tag :email, @email, required: true, autocomplete: "email", class: "text-input" %>
        <span class="auth-hint">We'll only use this to verify your account.</span>
      </label>

      <label class="auth-field">
        <span class="auth-label">Username</span>
        <%= text_field_tag :username, @username, required: true, autocomplete: "username", class: "text-input" %>
      </label>

      <label class="auth-field">
        <span class="auth-label">Password</span>
        <%= password_field_tag :password, nil, required: true, autocomplete: "new-password", class: "text-input" %>
      </label>

      <label class="auth-field">
        <span class="auth-label">Confirm password</span>
        <%= password_field_tag :password_confirmation, nil, required: true, autocomplete: "new-password", class: "text-input" %>
      </label>

      <button class="btn" type="submit" style="margin-top: 6px;">Register</button>

      <% if @error %>
        <div class="auth-error"><%= @error %></div>
      <% end %>
    <% end %>

    <p class="auth-alt">
      Already have an account? <%= link_to "Log in", login_path %>
    </p>
  </div>
</main>
