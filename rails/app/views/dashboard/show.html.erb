<% content_for :title, "Dashboard" %>

<main class="page">
  <div class="dashboard-stack">
    <div class="dashboard-greeting">
      <%= t(".welcome_back") %><%= @current_user["username"].present? ? ", #{@current_user["username"]}" : "" %>
    </div>

    <div class="card">
      <section class="progress-overview" aria-label="<%= t(".your_progress") %>">
        <div class="progress-group" aria-label="<%= t(".training_heading") %>">
          <h2 class="progress-group-label"><%= t(".training_heading") %></h2>
          <div class="progress-group-row">
            <div class="progress-stat">
              <span class="progress-stat-value">
                <span class="progress-stat-icon" aria-hidden="true">♟️</span>
                <%= @summary["positionsSeen"] || 0 %>
              </span>
              <span class="progress-stat-label"><%= t(".positions_trained") %></span>
            </div>
            <div class="progress-stat">
              <span class="progress-stat-value">
                <span class="progress-stat-icon" aria-hidden="true">🎯</span>
                <%= @summary["overallAccuracy"] ? "#{(@summary["overallAccuracy"] * 100).round}%" : "—" %>
              </span>
              <span class="progress-stat-label"><%= t(".accuracy") %></span>
            </div>
            <div class="progress-stat">
              <span class="progress-stat-value">
                <span class="progress-stat-icon" aria-hidden="true">📅</span>
                <%= @summary["currentStreak"] || 0 %><%= (@summary["currentStreak"].to_i > 0) ? " 🔥" : "" %>
              </span>
              <span class="progress-stat-label">
                <%= @summary["longestStreak"].to_i > 0 ? t(".day_streak_with_best", best: @summary["longestStreak"]) : t(".day_streak") %>
              </span>
            </div>
            <div class="progress-stat progress-stat--mastery">
              <span class="progress-stat-value">
                <span class="progress-stat-icon" aria-hidden="true">🏆</span>
                <%= @summary["mastered"] || 0 %>
              </span>
              <span class="progress-stat-label"><%= t(".mastered") %></span>
              <% if @summary["positionsSeen"].to_i > 0 %>
                <div class="mastery-bar" aria-hidden="true">
                  <div class="mastery-bar-fill" style="width: <%= [100, ((@summary["mastered"].to_f / @summary["positionsSeen"]) * 100).round].min %>%;"></div>
                </div>
              <% end %>
            </div>
            <div class="progress-stat">
              <%= button_to t(".review_due", count: @due_count), trainings_path, params: { from_due: true },
                    class: "progress-review-btn", disabled: @due_count.zero? %>
            </div>
          </div>

          <% if @weak_spots.any? %>
            <div class="progress-weak-spots">
              <span class="progress-stat-label"><%= t(".weak_spots") %></span>
              <ul>
                <% @weak_spots.each do |w| %>
                  <% pct = w["attempts"].to_i > 0 ? ((w["correctCount"].to_f / w["attempts"]) * 100).round : 0 %>
                  <% opening_name = w["openingName"] || t(".opening_fallback") %>
                  <li>
                    <div class="ws-row">
                      <span class="ws-name" title="<%= opening_name %>"><%= opening_name %></span>
                      <span class="ws-pct"><%= pct %>%</span>
                    </div>
                    <div class="ws-bar" aria-hidden="true">
                      <div class="ws-bar-fill" style="width: <%= pct %>%;"></div>
                    </div>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </section>

      <section class="opening-browser">
        <%= turbo_frame_tag "opening_browser" do %>
          <%= render "opening_browser" %>
        <% end %>
      </section>
    </div>
  </div>
</main>
