<% content_for :title, "Training" %>

<main class="page">
  <div class="card">
    <div class="train"
         data-controller="training"
         data-training-training-id-value="<%= @training_id %>"
         data-training-fen-value="<%= @fen %>"
         data-training-item-id-value="<%= @item_id %>"
         data-training-correct-move-uci-value="<%= @correct_move_uci %>"
         data-training-player-color-value="<%= @player_color %>"
         data-training-eco-value="<%= @eco %>"
         data-training-opening-name-value="<%= @opening_name %>"
         data-training-next-url-value="<%= training_next_path(@training_id) %>"
         data-training-moves-url-value="<%= training_moves_path(@training_id) %>"
         data-training-dashboard-url-value="<%= dashboard_path %>"
         data-training-board-theme-value="<%= @board_theme %>"
         data-training-piece-set-value="<%= @piece_set %>"
         data-training-show-coordinates-value="<%= @show_coordinates %>"
         data-training-board-animations-value="<%= @board_animations %>"
         data-training-board-orientation-mode-value="<%= @board_orientation_mode %>"
         data-training-sound-enabled-value="<%= @sound_enabled %>">
      <div class="train-board-col">
        <div class="training-board-wrap" data-training-target="host"></div>
        <div class="board-under">
          <span class="turn" data-training-target="turn">
            <span class="turn-dot" aria-hidden="true"></span>
            <span data-training-target="turnLabel"><%= t("training.whiteToMove") %></span>
          </span>
          <div class="board-toolbar">
            <button type="button" class="btn icon-btn" data-action="training#flip" aria-label="<%= t("flipBoard.label") %>" title="<%= t("flipBoard.label") %>">
              <span class="flip-icon" data-training-target="flipIcon" aria-hidden="true">⟳</span>
            </button>
            <button type="button" class="btn icon-btn hint-icon" data-action="training#showHint" data-training-target="hintButton" aria-label="<%= t("training.showHint") %>" title="<%= t("training.showHint") %>">
              💡
            </button>
          </div>
        </div>
      </div>

      <aside class="train-rail">
        <div class="rail-head">
          <div class="rail-eyebrow"><%= t("training.eyebrow") %></div>
          <div class="rail-title">
            <h1 data-training-target="openingName"><%= @opening_name %></h1>
            <% if @eco.present? %>
              <span class="eco-chip" data-training-target="ecoChip"><%= @eco %></span>
            <% end %>
          </div>
        </div>

        <div class="train-status your" data-training-target="status" role="status">
          <span class="train-status-ic" data-training-target="statusIcon" aria-hidden="true">♔</span>
          <div>
            <div class="train-status-msg" data-training-target="statusMsg"><%= t("trainings.show.your_move_status") %></div>
            <div class="train-status-sub" data-training-target="statusSub"></div>
          </div>
        </div>

        <div class="train-controls" data-training-target="inProgressControls">
          <div class="train-stepper">
            <button class="btn" type="button" data-action="training#prev" data-training-target="prevButton"><%= t("training.prev") %></button>
            <button class="btn" type="button" data-action="training#next" data-training-target="nextButton"><%= t("training.next") %></button>
          </div>

          <form class="train-type-move" data-action="training#submitTyped">
            <input class="text-input" type="text" placeholder="e2e4" data-training-target="moveInput" autocomplete="off">
            <button class="btn primary" type="submit" data-training-target="playButton"><%= t("training.play") %></button>
          </form>
        </div>

        <div class="train-controls" data-training-target="completedControls" hidden>
          <%= button_to t("training.trainAgain"),
                trainings_path(opening_eco: @eco, opening_name: @opening_name, player_color: @player_color),
                class: "btn primary" %>
          <%= link_to t("training.chooseAnother"), dashboard_path, class: "btn" %>
        </div>

        <button class="train-exit" type="button" data-training-target="exitButton" data-action="training#exit">
          <%= t("training.backToOpenings") %>
        </button>
      </aside>
    </div>
  </div>
</main>
