<% content_for :title, "Log in" %>

<main class="page">
  <div class="card" style="max-width: 520px; margin-top: 20px;">
    <h1 class="title" style="margin-bottom: 6px;"><%= t("auth.login.title") %></h1>
    <p class="subtitle"><%= t("auth.login.subtitle") %></p>

    <%= form_with url: login_path, method: :post, local: true, class: "auth-form" do %>
      <label class="auth-field">
        <span class="auth-label"><%= t("auth.login.usernameLabel") %></span>
        <%= text_field_tag :username, @username, required: true, autocomplete: "username", class: "text-input" %>
      </label>

      <label class="auth-field">
        <span class="auth-label"><%= t("auth.login.passwordLabel") %></span>
        <%= password_field_tag :password, nil, required: true, autocomplete: "current-password", class: "text-input" %>
      </label>

      <button class="btn" type="submit" style="margin-top: 14px;"><%= t("auth.login.submit") %></button>

      <% if @error %>
        <div class="auth-error"><%= @error %></div>
      <% end %>
    <% end %>

    <% if @email_not_verified %>
      <div style="margin-top: 14px;">
        <div class="auth-error"><%= t("auth.login.emailNotVerified") %></div>
        <%= button_to t("auth.login.resendVerification"), resend_verification_path, params: { username: @username }, class: "btn", style: "margin-top: 10px;" %>
      </div>
    <% end %>

    <p class="auth-alt">
      <%= t("auth.login.needAccount") %> <%= link_to t("auth.login.registerLink"), register_path %>
    </p>
  </div>
</main>
