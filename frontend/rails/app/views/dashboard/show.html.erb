<% content_for :title, "Dashboard" %>

<main class="page">
  <div class="dashboard-stack">
    <div class="dashboard-greeting">
      <%= t("dashboard.show.welcome_back") %><%= @current_user["username"].present? ? ", #{@current_user["username"]}" : "" %>
    </div>

    <div class="card">
      <div class="stat-tabs" role="tablist" aria-label="<%= t("dashboard.progress.yourProgress") %>" data-controller="stat-tabs">
        <button type="button" role="tab" aria-selected="true" class="stat-tab active"
              data-stat-tabs-target="trainingTab" data-action="stat-tabs#showTraining">
          <%= t("dashboard.progress.trainingHeading") %>
        </button>
        <button type="button" role="tab" aria-selected="false" class="stat-tab"
              data-stat-tabs-target="puzzlesTab" data-action="stat-tabs#showPuzzles">
          <%= t("dashboard.progress.puzzlesHeading") %>
        </button>
      </div>
      <section class="progress-overview" aria-label="<%= t("dashboard.progress.yourProgress") %>" data-mobile-tab="training" data-stat-tabs-target="overview">
        <div class="progress-group progress-group--training" aria-label="<%= t("dashboard.progress.trainingLabel") %>">
          <h2 class="progress-group-label"><%= t("dashboard.progress.trainingHeading") %></h2>
          <div class="progress-group-row">
            <div class="progress-stat">
              <span class="progress-stat-value">
                <span class="progress-stat-icon" aria-hidden="true">♟️</span>
                <%= @summary["positionsSeen"] || 0 %>
              </span>
              <span class="progress-stat-label"><%= t("dashboard.progress.positionsTrained") %></span>
            </div>
            <div class="progress-stat">
              <span class="progress-stat-value">
                <span class="progress-stat-icon" aria-hidden="true">🎯</span>
                <%= @summary["overallAccuracy"] ? "#{(@summary["overallAccuracy"] * 100).round}%" : "—" %>
              </span>
              <span class="progress-stat-label"><%= t("dashboard.progress.accuracy") %></span>
            </div>
            <div class="progress-stat">
              <span class="progress-stat-value">
                <span class="progress-stat-icon" aria-hidden="true">📅</span>
                <%= @summary["currentStreak"] || 0 %><%= (@summary["currentStreak"].to_i > 0) ? " 🔥" : "" %>
              </span>
              <span class="progress-stat-label">
                <%= @summary["longestStreak"].to_i > 0 ? t("dashboard.progress.dayStreakBest", best: @summary["longestStreak"]) : t("dashboard.progress.dayStreak") %>
              </span>
            </div>
            <div class="progress-stat progress-stat--mastery">
              <span class="progress-stat-value">
                <span class="progress-stat-icon" aria-hidden="true">🏆</span>
                <%= @summary["mastered"] || 0 %>
              </span>
              <span class="progress-stat-label"><%= t("dashboard.progress.mastered") %></span>
              <% if @summary["positionsSeen"].to_i > 0 %>
                <div class="mastery-bar" aria-hidden="true">
                  <div class="mastery-bar-fill" style="width: <%= [100, ((@summary["mastered"].to_f / @summary["positionsSeen"]) * 100).round].min %>%;"></div>
                </div>
              <% end %>
            </div>
            <div class="progress-stat">
              <%= button_to t("dashboard.progress.reviewDue", count: @due_count), trainings_path, params: { from_due: true },
                    class: "progress-review-btn", disabled: @due_count.zero? %>
            </div>
          </div>

          <% if @weak_spots.any? || @trouble_steps.any? %>
            <% top_weak_spot = @weak_spots.first %>
            <% top_trouble_step = @trouble_steps.first %>
            <div class="ws-container" data-controller="needs-work">
              <div class="ws-grid">
                <% if top_weak_spot %>
                  <% name = top_weak_spot["openingName"] || t("dashboard.progress.weakSpotFallbackName") %>
                  <% pct = top_weak_spot["attempts"].to_i > 0 ? ((top_weak_spot["correctCount"].to_f / top_weak_spot["attempts"]) * 100).round : 0 %>
                  <div class="ws-tile" role="group" aria-label="<%= t("dashboard.progress.weakestOpening") %>">
                    <span class="ws-label"><%= t("dashboard.progress.weakestOpening") %></span>
                    <span class="ws-title" title="<%= name %>"><%= name %></span>
                    <div class="ws-stat">
                      <span class="ws-value"><%= pct %>%</span>
                      <span class="ws-stat-label"><%= t("dashboard.progress.accuracy") %></span>
                    </div>
                  </div>
                <% end %>

                <% if top_trouble_step %>
                  <% name = top_trouble_step["openingName"] || t("dashboard.progress.weakSpotFallbackName") %>
                  <% move_number = (top_trouble_step["orderIndex"].to_i / 2) + 1 %>
                  <% pct = (top_trouble_step["accuracy"].to_f * 100).round %>
                  <% top_wrong_move = top_trouble_step["commonWrongMoves"]&.first %>
                  <div class="ws-tile" role="group" aria-label="<%= t("dashboard.progress.trickiestMove") %>">
                    <span class="ws-label"><%= t("dashboard.progress.trickiestMove") %></span>
                    <span class="ws-title" title="<%= name %> · <%= t("dashboard.progress.moveAbbrev", move: move_number) %>">
                      <%= name %> · <%= t("dashboard.progress.moveAbbrev", move: move_number) %>
                    </span>
                    <div class="ws-stat">
                      <span class="ws-value"><%= pct %>%</span>
                      <span class="ws-stat-label">
                        <%= top_wrong_move ? t("dashboard.progress.troubleSpotWrongMoveShort", move: top_wrong_move["moveUci"]) : t("dashboard.progress.accuracy") %>
                      </span>
                    </div>
                  </div>
                <% end %>
              </div>

              <% if @weak_spots.size > 1 || @trouble_steps.size > 1 %>
                <div class="ws-footer">
                  <button type="button" class="ws-link" data-action="needs-work#toggle" data-needs-work-target="toggleBtn"
                          data-collapsed-label="<%= t("dashboard.progress.seeAllWeakSpots", count: @weak_spots.size + @trouble_steps.size) %>"
                          data-expanded-label="<%= t("dashboard.progress.seeLess") %>" aria-expanded="false" aria-controls="needs-work-expanded">
                    <%= t("dashboard.progress.seeAllWeakSpots", count: @weak_spots.size + @trouble_steps.size) %>
                  </button>
                </div>

                <div class="ws-expanded" id="needs-work-expanded" data-needs-work-target="panel" hidden="hidden">
                  <% @weak_spots.drop(1).each do |w| %>
                    <% name = w["openingName"] || t("dashboard.progress.weakSpotFallbackName") %>
                    <% pct = w["attempts"].to_i > 0 ? ((w["correctCount"].to_f / w["attempts"]) * 100).round : 0 %>
                    <div class="ws-row">
                      <div class="ws-row-main">
                        <span class="ws-row-name" title="<%= name %>"><%= name %></span>
                        <span class="ws-row-sub"><%= t("dashboard.progress.wholeOpening") %></span>
                      </div>
                      <span class="ws-row-pct"><%= pct %>%</span>
                    </div>
                  <% end %>
                  <% @trouble_steps.drop(1).each do |s| %>
                    <% name = s["openingName"] || t("dashboard.progress.weakSpotFallbackName") %>
                    <% move_number = (s["orderIndex"].to_i / 2) + 1 %>
                    <% pct = (s["accuracy"].to_f * 100).round %>
                    <% top_wrong_move = s["commonWrongMoves"]&.first %>
                    <div class="ws-row">
                      <div class="ws-row-main">
                        <span class="ws-row-name" title="<%= name %>"><%= name %></span>
                        <span class="ws-row-sub">
                          <%= top_wrong_move ? t("dashboard.progress.troubleSpotItemWithWrongMove", move: move_number, wrongMove: top_wrong_move["moveUci"]) : t("dashboard.progress.moveAbbrev", move: move_number) %>
                        </span>
                      </div>
                      <span class="ws-row-pct"><%= pct %>%</span>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="progress-group progress-group--puzzles" aria-label="<%= t("dashboard.progress.puzzleLabel") %>">
          <h2 class="progress-group-label"><%= t("dashboard.progress.puzzlesHeading") %></h2>
          <div class="progress-group-row">
            <div class="progress-stat">
              <span class="progress-stat-value">
                <span class="progress-stat-icon" aria-hidden="true">🧩</span>
                <%= @puzzle_summary["puzzlesSeen"] || 0 %>
              </span>
              <span class="progress-stat-label"><%= t("dashboard.progress.puzzlesSolved") %></span>
            </div>
            <div class="progress-stat">
              <span class="progress-stat-value">
                <span class="progress-stat-icon" aria-hidden="true">🎯</span>
                <%= (@puzzle_summary["overallAccuracy"] && @puzzle_summary["puzzlesSeen"].to_i > 0) ? "#{(@puzzle_summary["overallAccuracy"] * 100).round}%" : "—" %>
              </span>
              <span class="progress-stat-label"><%= t("dashboard.progress.accuracy") %></span>
            </div>
            <div class="progress-stat">
              <span class="progress-stat-value">
                <span class="progress-stat-icon" aria-hidden="true">🏆</span>
                <%= @puzzle_summary["mastered"] || 0 %>
              </span>
              <span class="progress-stat-label"><%= t("dashboard.progress.mastered") %></span>
            </div>
            <div class="progress-stat">
              <%= link_to t("dashboard.progress.practicePuzzles"), puzzle_themes_path, class: "progress-review-btn" %>
            </div>
          </div>
        </div>
      </section>

      <section class="opening-browser">
        <%= turbo_frame_tag "opening_browser" do %>
          <%= render "opening_browser" %>
        <% end %>
      </section>
    </div>
  </div>
</main>
