<% content_for :title, "Settings" %>

<main class="page">
  <div class="card settings-card">
    <h1 class="title"><%= t("settings.title") %></h1>
    <p class="subtitle"><%= t("settings.subtitle") %></p>

    <section class="settings-section settings-section--preview">
      <span class="settings-row-label"><%= t("settings.previewLabel") %></span>
      <div class="settings-preview-board" data-controller="board-preview"
            data-board-preview-position-value="rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
            data-board-preview-orientation-value="<%= @preferences["board_orientation_mode"] == "black" ? "black" : "white" %>"
            data-board-preview-board-theme-value="<%= @preferences["board_theme"] %>"
            data-board-preview-piece-set-value="<%= @preferences["piece_set"] %>"
            data-board-preview-show-coordinates-value="<%= @preferences["show_coordinates"] %>"
            data-board-preview-interactive-value="true">
        <div class="boardPreview-board" data-board-preview-target="host"></div>
      </div>
    </section>

    <%= form_with url: settings_path, method: :patch do %>
      <section class="settings-section">
        <div class="settings-row">
          <span class="settings-row-label"><%= t("settings.languageLabel") %></span>
          <%= select_tag :language,
                options_for_select(SettingsController::LANGUAGES.map { |v| [SettingsController::LANGUAGE_FLAGS[v] || v, v] }, @preferences["language"]),
                id: "settings-language", class: "text-input settings-select", onchange: "this.form.requestSubmit()" %>
        </div>
      </section>

      <section class="settings-section">
        <h2 class="settings-section-heading"><%= t("settings.appearance.heading") %></h2>

        <div class="settings-row">
          <span class="settings-row-label"><%= t("settings.appearance.themeLabel") %></span>
          <div class="settings-radio-group" role="radiogroup" aria-label="<%= t("settings.appearance.themeLabel") %>" data-controller="theme-select">
            <% SettingsController::THEMES.each do |theme| %>
              <label class="settings-radio">
                <%= radio_button_tag :theme, theme, @preferences["theme"] == theme, data: { action: "change->theme-select#apply" }, onchange: "this.form.requestSubmit()" %>
                <%= t("theme.#{theme}") %>
              </label>
            <% end %>
          </div>
        </div>

        <label class="settings-row" for="settings-board-theme">
          <span class="settings-row-label"><%= t("settings.appearance.boardThemeLabel") %></span>
          <%= select_tag :board_theme,
                options_for_select(SettingsController::BOARD_THEMES.map { |v| [t("settings.boardThemes.#{v}"), v] }, @preferences["board_theme"]),
                id: "settings-board-theme", class: "text-input settings-select", onchange: "this.form.requestSubmit()" %>
        </label>

        <label class="settings-row" for="settings-piece-set">
          <span class="settings-row-label"><%= t("settings.appearance.pieceSetLabel") %></span>
          <%= select_tag :piece_set,
                options_for_select(SettingsController::PIECE_SETS.map { |v| [t("settings.pieceSets.#{v}"), v] }, @preferences["piece_set"]),
                id: "settings-piece-set", class: "text-input settings-select", onchange: "this.form.requestSubmit()" %>
        </label>

        <label class="settings-row settings-row--checkbox">
          <span class="settings-row-label"><%= t("settings.appearance.showCoordinatesLabel") %></span>
          <span class="settings-switch">
            <%= hidden_field_tag :show_coordinates, "0", id: nil %>
            <%= check_box_tag :show_coordinates, "1", @preferences["show_coordinates"], role: "switch", onchange: "this.form.requestSubmit()" %>
            <span class="settings-switch-track" aria-hidden="true"></span>
          </span>
        </label>

        <label class="settings-row settings-row--checkbox">
          <span class="settings-row-label"><%= t("settings.appearance.boardAnimationsLabel") %></span>
          <span class="settings-switch">
            <%= hidden_field_tag :board_animations, "0", id: nil %>
            <%= check_box_tag :board_animations, "1", @preferences["board_animations"], role: "switch", onchange: "this.form.requestSubmit()" %>
            <span class="settings-switch-track" aria-hidden="true"></span>
          </span>
        </label>

        <label class="settings-row settings-row--checkbox">
          <span class="settings-row-label"><%= t("settings.appearance.soundLabel") %></span>
          <span class="settings-switch">
            <%= hidden_field_tag :sound, "0", id: nil %>
            <%= check_box_tag :sound, "1", @preferences["sound"], role: "switch", onchange: "this.form.requestSubmit()" %>
            <span class="settings-switch-track" aria-hidden="true"></span>
          </span>
        </label>
      </section>

      <section class="settings-section">
        <h2 class="settings-section-heading"><%= t("settings.boardOrientation.heading") %></h2>
        <div class="settings-radio-group settings-radio-group--stacked" role="radiogroup" aria-label="<%= t("settings.boardOrientation.heading") %>">
          <% SettingsController::ORIENTATION_MODES.each do |mode| %>
            <label class="settings-radio">
              <%= radio_button_tag :board_orientation_mode, mode, @preferences["board_orientation_mode"] == mode, onchange: "this.form.requestSubmit()" %>
              <%= t("settings.boardOrientation.#{mode}") %>
            </label>
          <% end %>
        </div>
      </section>
    <% end %>

    <section class="settings-section">
      <label class="settings-row settings-row--checkbox">
        <span class="settings-row-label"><%= t("settings.appearance.snowLabel") %></span>
        <span class="settings-switch">
          <input type="checkbox" role="switch" data-snow-target="toggleInput" data-action="change->snow#toggle">
          <span class="settings-switch-track" aria-hidden="true"></span>
        </span>
      </label>
    </section>

    <section class="settings-section settings-section--footer">
      <%= button_to t("settings.resetToDefaults"), settings_path, method: :patch,
            params: SettingsController::DEFAULTS,
            class: "btn",
            data: { turbo_confirm: t("settings.resetConfirm") } %>
    </section>
  </div>
</main>
