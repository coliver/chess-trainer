<header class="home-header">
  <div class="home-header-inner">
    <div class="home-header-top">
      <div class="home-header-brand-group">
        <button
          class="home-header-menu-button"
          id="header-menu-btn"
          aria-label="Menu"
          aria-expanded="false"
          data-controller="header-menu"
          data-action="click->header-menu#toggle"
        >
          ☰
        </button>
        <div class="home-header-branding">
          <img src="/rails/favicon.svg" alt="" class="home-header-icon" height="24">
          <%= link_to t("header.title"), (logged_in? ? dashboard_path : login_path), class: "home-header-title-text" %>
        </div>
      </div>

      <% if logged_in? %>
        <nav class="home-header-tabs" aria-label="Main">
          <%= link_to t("header.openings"), dashboard_path,
                class: "home-header-tab#{' active' if request.path.start_with?(dashboard_path)}" %>
          <%= link_to t("header.puzzles"), puzzle_themes_path,
                class: "home-header-tab#{' active' if request.path.start_with?(puzzles_path)}" %>
        </nav>
      <% end %>

      <%= render "layouts/header_menu" if logged_in? %>
    </div>
  </div>
</header>
