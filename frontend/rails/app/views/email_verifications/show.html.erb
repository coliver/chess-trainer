<% content_for :title, "Verify email" %>

<main class="page">
  <div class="card" style="max-width: 520px; margin-top: 20px;">
    <% if @state == :success %>
      <h1 class="title" style="margin-bottom: 6px;"><%= t("auth.verifyEmail.successTitle") %></h1>
      <p class="subtitle">
        <% if @email %>
          <%= t("auth.verifyEmail.successSubtitleWithEmail", email: @email) %>
        <% else %>
          <%= t("auth.verifyEmail.successSubtitleNoEmail") %>
        <% end %>
      </p>
      <p style="margin-top: 20px;">
        <%= link_to t("auth.verifyEmail.goToLogin"), login_path, class: "btn", style: "display: inline-block;" %>
      </p>
    <% else %>
      <h1 class="title" style="margin-bottom: 6px;"><%= t("auth.verifyEmail.errorTitle") %></h1>
      <p class="subtitle"><%= t("auth.verifyEmail.errorSubtitle") %></p>
      <p style="margin-top: 20px;">
        <%= link_to t("auth.verifyEmail.returnToLogin"), login_path, class: "btn", style: "display: inline-block;" %>
      </p>
    <% end %>
  </div>
</main>
