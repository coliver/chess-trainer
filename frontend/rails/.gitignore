# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules

# Generated at container boot (see Dockerfile CMD) by copying from the
# bind-mounted /packages/shared-assets/ (source of truth for these files).
/public/rails/cm-chessboard-assets/
/public/rails/sounds/

# Ignore key files for decrypting credentials and more. test.key is
# intentionally committed (see below) — it holds no real secrets and CI
# needs it to boot the app in RAILS_ENV=test.
/config/credentials/*.key
!/config/credentials/test.key

# SimpleCov output
/coverage/

