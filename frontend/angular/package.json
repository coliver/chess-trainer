{
  "name": "angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "sync-i18n": "node scripts/sync-i18n-locales.mjs",
    "start": "npm run sync-i18n && ng serve",
    "build": "npm run sync-i18n && ng build",
    "watch": "npm run sync-i18n && ng build --watch --configuration development",
    "test": "npm run sync-i18n && ng test",
    "test:ci": "npm run sync-i18n && ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "test:playwright": "npm run sync-i18n && playwright test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@knight-school/chess-core": "file:../packages/chess-core",
    "cm-chessboard": "^8.12.19",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@playwright/test": "^1.62.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "22.1.0",
    "eslint": "^9.28.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
